#
# Bare git dotfiles's gitgnore
#
# Setup as .git/info/exclude:
#   $> ln -sfT -r .dotfiles.gitignore .dotfiles.git/info/exclude
#
# Using `info/exclude` should conflict less than a `~/.gitignore`
#
# Notes:
#
# List ignored files here:
# $ git check-ignore *
#
# This should be empty (files tracked but ignored):
# $ git ls-ignored-tracked
#

# Ignore all here
/*

# Un-ignore those:

!/.gitconfig
!/.gitmodules
!/.gitignore
!/.gitignore.global
!/.dotfiles.gitignore

!/.bash_profile
!/.bashrc
!/.editorconfig.example
!/.gdbinit
!/.inputrc
!/.tigrc
!/.toprc
!/.xinitrc
!/.Xresources
!/.Xdefaults
!/.zshrc
!/.ccache
!/.emacs.d
!/.doom.d
!/.i3
!/.mpv
!/.ncmpcpp
!/.oh-my-zsh
!/.omz.custom
!/.ssh
!/.userscripts
!/.gtkrc-2.0

!/.config

!/bin
!/dotfiles
!/SNIPPETS.md