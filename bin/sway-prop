#!/bin/bash
#
# Ask to select a visible window and prints its sway node properties
#

set -euo pipefail

rect_code='(.rect | "\(.x),\(.y) \(.width)x\(.height)")'

tree_json="$(swaymsg -t get_tree)"

rect="$(
    jq <<<"$tree_json" -r 'recurse(.nodes[]) | select(.visible) | '"$rect_code" \
        | slurp -r
)"

jq <<<"$tree_json" -r --arg rect "$rect" '[recurse(.nodes[]) | select(.visible and '"$rect_code"' == $rect)] | first'
